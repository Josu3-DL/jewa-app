<%- include('../partials/layout-start', { title: title, active: active }) %>
                <section class="welcome-row">
                    <div>
                        <p class="eyebrow">CLIENTES</p>
                        <h1>Clientes</h1>
                        <p class="intro">Propietarios de las mascotas, sus contactos y si aceptan recordatorios.</p>
                    </div>
                </section>

                <form class="data-form filter-bar" method="get" action="/clientes" role="search">
                    <label for="f-q">Buscar
                        <input id="f-q" name="q" type="search" value="<%= q %>" maxlength="100" placeholder="Nombre, cédula o teléfono" autocomplete="off">
                    </label>
                    <label class="check-row"><input type="checkbox" name="inactivos" value="1"<%= inactivos ? ' checked' : '' %>> Incluir inactivos</label>
                    <div class="filter-actions">
                        <button class="button" type="submit">Buscar</button>
                        <a class="text-link text-link-dark" href="/clientes">Limpiar</a>
                    </div>
                </form>

                <div class="management-grid">
                    <form class="data-form" method="post" action="/clientes" novalidate>
                        <h3>Nuevo cliente</h3>
                        <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
                        <%- include('../partials/cliente-campos', { values: values, errors: errors }) %>
                        <button class="button" type="submit">Crear cliente</button>
                    </form>

                    <div class="data-list-panel">
                        <div class="list-heading"><h3>Clientes registrados</h3><span><%= total %></span></div>
                        <% if (filas.length) { %>
                        <div class="record-list">
                            <% filas.forEach(function (c) { %>
                            <article class="record">
                                <div class="record-main">
                                    <div class="pet-avatar pet-dog" aria-hidden="true"><%= c.nombre.charAt(0).toUpperCase() %></div>
                                    <div class="record-copy">
                                        <strong><%= c.nombre %></strong>
                                        <span><%= c.telefonoTexto %><% if (c.cedula) { %> · <%= c.cedula %><% } %> · <%= c.mascotas_activas %> mascota<%= c.mascotas_activas === 1 ? '' : 's' %></span>
                                    </div>
                                </div>
                                <div class="record-actions">
                                    <% if (!c.activo) { %><span class="status <%= c.estado.clase %>"><%= c.estado.texto %></span><% } %>
                                    <a class="record-confirm" href="/clientes/<%= c.id %>" aria-label="Ver ficha de <%= c.nombre %>">Ver ficha</a>
                                </div>
                            </article>
                            <% }) %>
                        </div>
                        <%- include('../partials/pagination', { pager: pager }) %>
                        <% } else { %>
                        <p class="empty-state"><%= q ? 'Ningún cliente coincide con la búsqueda.' : 'Todavía no hay clientes. Crea el primero con el formulario.' %></p>
                        <% } %>
                    </div>
                </div>
<%- include('../partials/layout-end') %>
