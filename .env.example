# Copiar a .env y completar. .env NO se sube a git.
HOST=0.0.0.0
PORT=3000
# Cadena larga y aleatoria (mínimo 32 caracteres). Ej.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# false mientras se use HTTP en la red local (D-25). true solo si algún día se usa HTTPS.
COOKIE_SECURE=false
DB_PATH=./data/clinic.db
UPLOAD_DIR=./uploads
# Unidad externa para respaldos (D-26)
BACKUP_DIR=./backups
NODE_ENV=production

# SOLO DESARROLLO (se rechaza en producción): simula un usuario mientras no hay login.
# Valores: admin | veterinario | recepcion
# DEV_ROLE=admin
